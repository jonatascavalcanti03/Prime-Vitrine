// prisma/schema.prisma
// Plataforma de Afiliados Automatizada - Mercado Livre
// Banco: PostgreSQL (Supabase) | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// USER & AUTH – NextAuth.js v5 (Auth.js)
// ─────────────────────────────────────────────
enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  accessLogs           AccessLog[]
  mercadoLivreAccounts MercadoLivreAccount[]

  @@index([email])
  @@map("users")
}

model MercadoLivreAccount {
  id           String   @id @default(cuid())
  userId       String
  mlUserId     String   @unique
  nickname     String?
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mercado_livre_accounts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// CATEGORY – Categorias de Ofertas
// ─────────────────────────────────────────────
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// PRODUCT – Ofertas Curadas de Afiliado
// ─────────────────────────────────────────────
enum ProductStatus {
  AVAILABLE
  PAUSED
  EXPIRED
}

model Product {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String?       @db.Text
  brand           String?
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName    String        @default("Geral")
  
  // Preços
  price           Decimal       @db.Decimal(10, 2)
  originalPrice   Decimal?      @db.Decimal(10, 2)
  discountPercent Int?

  // Precificação Dropshipping / Automação ML
  costPrice        Float?
  profitMargin     Float?
  mlFeePercent     Float?
  mlItemId         String?
  mlPermalink      String?       @db.Text
  plainDescription String?       @db.Text
  listingType      String        @default("gold_special")
  mlCategoryId     String?
  syncStatus       String        @default("DRAFT")

  // URLs de Afiliado (Mercado Livre)
  originalUrl     String        @db.Text // URL direta do anúncio
  affiliateUrl    String        @db.Text // URL com seu tracking de afiliado

  // Mídia (Imagens extraídas)
  mediaUrls       Json          @default("[]") // [{ url: string, type: 'image' }]

  // Visibilidade & Destaque
  stock           Int           @default(10)
  status          ProductStatus @default(AVAILABLE)
  featured        Boolean       @default(false)
  views           Int           @default(0)
  clicksCount     Int           @default(0)

  // Enriquecimento com IA (Google Gemini)
  aiSummary       String?       @db.Text // Resumo conciso e persuasivo
  aiPros          Json?         // Array de strings com pontos positivos
  aiCons          Json?         // Array de strings com pontos de atenção

  // Rastreamento de Cliques
  clicks          ClickAnalytics[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([categoryName])
  @@index([slug])
  @@map("products")
}

// ─────────────────────────────────────────────
// CLICK ANALYTICS – Rastreamento de Conversão
// ─────────────────────────────────────────────
model ClickAnalytics {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userAgent String?  @db.Text
  referrer  String?  @db.Text
  clickedAt DateTime @default(now())

  @@index([productId])
  @@index([clickedAt])
  @@map("click_analytics")
}

// ─────────────────────────────────────────────
// ACCESS LOG – Auditoria de Acesso Admin
// ─────────────────────────────────────────────
model AccessLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("access_logs")
}
